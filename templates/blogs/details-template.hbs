{{#each data}}
<div class="clearfix py-3">
    <h3>{{name}}</h3>
    <p class="text-black-50">by {{author}} in <a href="?request=blogs/categories/{{category.id}}">{{category.name}}</a> on {{formatDate date}} <a href="#comments">Comments ({{comments.length}})</a></p>
    <img src="{{imagepath}}" alt="{{name}}" class="float-start me-3 rounded-4">
    <div class="text-black-50">{{{description}}}</div>
</div>

<div class="py-2" id="leave-comment">
    <h3>Leave your comments</h3>
    <form action="#" method="post" class="text-black-50" onsubmit="addComment(event)">
        <input type="hidden" name="blogId" id="blogId" value="{{id}}">
        <div class="row">
            <div class="col-4">
                <div class="mb-3">
                    <label for="name" class="form-label">Name (Required)</label>
                    <input type="text" class="form-control form-control-sm" name="name" id="name" placeholder=""
                        required />
                </div>
            </div>
            <div class="col">
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="text" class="form-control form-control-sm" name="email" id="email" placeholder=""
                        pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" required />
                </div>
            </div>
        </div>
        <div class="mb-3">
            <textarea class="form-control" name="comment" id="comment" rows="3" required></textarea>
        </div>
        <div class="row">
            <div class="col">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="1" id="agree" required />
                    <label class="form-check-label" for="agree">Agree to terms and conditions.</label>
                </div>
            </div>
            <div class="col text-end">
                <button type="submit" class="btn btn-link text-decoration-none p-0">
                    Submit Comment
                </button>
            </div>
        </div>
        <div class="text-center">
            <div class="text-success" id="responseMessage"></div>
        </div>
    </form>
</div>
<div class="py-3">
    <a id="comments"></a>
    <div class="bg-dark text-white-50 p-2 mb-3">COMMENTS ({{comments.length}})</div>
    {{#each comments}}
    <div class="text-black-50">
        <p>{{name}} &nbsp;&nbsp; {{formatDate date}}</p>
        <p>{{summary}}</p>
        <hr>
    </div>
    {{/each}}
</div>
{{/each}}