{{#each data}}
<h1 class="py-3">{{name}}</h1>
<div>
    <a href="?request=aboutus/{{id}}" class="text-decoration-none">
        <img src="{{thumbpath}}" alt="{{name}}" class="float-start rounded-4 me-3">
        <div class="text-black-50">{{{summary}}}</div>
    </a>
    <a href="?request=aboutus/{{id}}" class="btn btn-link ps-0 readmore">Read more</a>
</div>
{{/each}}